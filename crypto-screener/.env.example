# --- режим ---
MODE=live                 # live = реальные биржи | replay = демо без интернета
PORT=8000
LOG_LEVEL=INFO

# --- биржи ---
EXCHANGES=binanceusdm,bybit,okx,binance   # или EXCHANGES_ALL=1 для всех 11
TOP_N=300                 # сколько инструментов стримить на биржу
BOOKS=80                  # для скольких держать стакан (плотности)
FETCH_OHLCV=1             # свечи для NATR и мульти-ТФ доходности
TICKER_REFRESH=20         # период REST-среза тикеров, сек

# --- метрики ---
BIG_DENSITY_USD=50000     # порог «крупной плотности» в стакане
# как часто пересчитывать плотности/имбаланс стакана, сек (тяжёлая операция;
# биржи шлют стаканы 5-10 раз/с, глазу достаточно 4 Гц). 0 = без троттлинга
BOOK_DENSITY_INTERVAL=0.25
VOLUME_SPIKE_RATIO=3.0    # во сколько раз объём должен превысить базу
TRADES_SPIKE_RATIO=3.0
QUOTES=USDT,USDC,USD,BUSD,FDUSD

# --- стрим во фронтенд ---
PUSH_INTERVAL=1.0

# --- фокус-режим (включается галочкой в UI, работает без перезапуска) ---
# Одна биржа + один рынок + top-N монет по вашему фильтру; стримы держатся
# только на них, отбор перепроверяется каждые N секунд, прочие биржи на паузе.
# Замер: подписок 450 -> 50, сетка 9 графиков 21 c -> 0.13 c.
# Параметры ниже - значения по умолчанию; менять их нужно в app/focus.py.
# FOCUS_LIMIT=50          # сколько монет стримить
# FOCUS_INTERVAL=15       # как часто перепроверять отбор, сек
# FOCUS_PAUSE_OTHERS=1    # гасить потоки прочих бирж
# Если нужен ЛЁГКИЙ запуск сразу (без клика в UI), ограничьте профиль:
# EXCHANGES=binanceusdm MARKETS=swap TOP_N=50 BOOKS=25 FETCH_OHLCV=1

# --- прокси (нужен при геоблокировке бирж) ---
# Покрывает и REST, и WebSocket. Можно вместо этого задать HTTPS_PROXY.
PROXY_URL=
# PROXY_URL=http://127.0.0.1:1080

# --- DNS-резолвер aiohttp ---
# threaded (по умолчанию) - системный резолвер Windows (как у браузера).
# aiodns - дефолт aiohttp: прямые UDP-запросы к DNS-серверу; их часто
# блокируют антивирус/файрвол/VPN ("Could not contact DNS servers").
# DNS_RESOLVER=threaded

# --- алерты в Telegram (необязательно) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
