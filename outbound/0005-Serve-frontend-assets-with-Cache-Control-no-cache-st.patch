From 905031c1dfefbf4e01421d46bc72f5b54853d4a5 Mon Sep 17 00:00:00 2001
From: "qwen.ai[bot]" <qwenlm-intl@service.alibaba.com>
Date: Sat, 3 Oct 2026 14:42:54 +0000
Subject: [PATCH 5/5] Serve frontend assets with Cache-Control: no-cache (stale
 chart.js kept in browser cache)

---
 crypto-screener/app/api.py | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/crypto-screener/app/api.py b/crypto-screener/app/api.py
index bd2f392..af97b83 100644
--- a/crypto-screener/app/api.py
+++ b/crypto-screener/app/api.py
@@ -995,19 +995,28 @@ async def index():
     return JSONResponse({"hint": "frontend не найден; API доступно на /api/*"}, status_code=200)
 
 
+# Статические файлы фронта отдаём с no-cache: браузеры (и их disk cache)
+# иначе держат старую версию скриптов после обновления кода — правки в
+# chart.js/app.js «не применяются», пока не сделаешь жёсткое перезагружение.
+_NOCACHE = {"Cache-Control": "no-cache, must-revalidate"}
+
+
 @app.get("/app.js")
 async def app_js():
-    return FileResponse(WEB_DIR / "app.js", media_type="application/javascript")
+    return FileResponse(WEB_DIR / "app.js", media_type="application/javascript",
+                        headers=_NOCACHE)
 
 
 @app.get("/chart.js")
 async def chart_js():
-    return FileResponse(WEB_DIR / "chart.js", media_type="application/javascript")
+    return FileResponse(WEB_DIR / "chart.js", media_type="application/javascript",
+                        headers=_NOCACHE)
 
 
 @app.get("/style.css")
 async def style_css():
-    return FileResponse(WEB_DIR / "style.css", media_type="text/css")
+    return FileResponse(WEB_DIR / "style.css", media_type="text/css",
+                        headers=_NOCACHE)
 
 
 @app.get("/healthz")
